{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "${OPENCODE_PROVIDER_ID}": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "${OPENCODE_PROVIDER_NAME}",
      "options": {
        "baseURL": "${OPENCODE_PROVIDER_BASE_URL}",
        "apiKey": "${OPENCODE_PROVIDER_API_KEY}"
      },
      "models": {
        "${OPENCODE_MODEL_ID}": {
          "name": "${OPENCODE_MODEL_NAME}",
          "limit": {
            "context": 262144,
            "input": 204800,
            "output": 36864
          },
          "variants":{
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          },
          "options": {
            "extra_body": {
                "top_k": 20,
                "min_p": 0.0,
                "repetition_penalty": 1.0,
                "chat_template_kwargs": {
                    "enable_thinking": true,
                    "preserve_thinking": true
                }
            }
          }
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reversed": 10240,
    "tail_turns": 10,
    "preserve_recent_tokens": 20480
  },
  "skills": {
    "paths": [
        "${OPENCODE_SKILL_PATH_1}",
        "${OPENCODE_SKILL_PATH_2}"
    ]
  }
}